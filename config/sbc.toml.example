# NIXI SBC — example configuration
#
# Static config lives here. DYNAMIC config (SIP users, DIDs, trunks, routes,
# ACL rules) lives in the SQLite store (database.sqlite_path) and is managed
# through the REST API. Entries below ([security.sip_users], [[trunks]],
# [[dids]]) are IMPORT-ONCE SEEDS: they populate the store on first boot and
# are ignored afterwards — the store is the source of truth.

[general]
name = "NIXI-SBC"
instance_id = "sbc-01"
# JSON-lines CDR file (optional; rotate with logrotate)
cdr_file = "/var/log/sbc/cdr.jsonl"

[network]
# Public IP for topology hiding / SDP rewriting
public_ipv4 = "203.0.113.10"

[[network.listeners]]
transport = "UDP"
bind_address = "0.0.0.0"
bind_port = 5060

[[network.listeners]]
transport = "TCP"
bind_address = "0.0.0.0"
bind_port = 5060

# TLS + WSS need a certificate the clients trust (e.g. Let's Encrypt)
#[[network.listeners]]
#transport = "TLS"
#bind_address = "0.0.0.0"
#bind_port = 5061
#cert_file = "/etc/letsencrypt/live/sip.example.com/fullchain.pem"
#key_file  = "/etc/letsencrypt/live/sip.example.com/privkey.pem"

# SIP over WebSocket for browsers (WebRTC) — see docs/WEBRTC.md
#[[network.listeners]]
#transport = "WSS"
#bind_address = "0.0.0.0"
#bind_port = 8443
#cert_file = "/etc/letsencrypt/live/sip.example.com/fullchain.pem"
#key_file  = "/etc/letsencrypt/live/sip.example.com/privkey.pem"

[media]
# The RTP/RTCP pair pool. A freed pair rests 30 s before it can be reused,
# so a new call never inherits the previous peer's stray packets: size the
# range for the call rate, not just for the concurrent calls
# (sbc_rtp_port_quarantine_forced_total counts a range that is too small).
rtp_port_range = [10000, 20000]
# Parsed, read by nothing (see the "unused" class in docs/API.md): RTCP is
# always relayed, transcoding runs on the relay task, and the codecs of a
# call come from the SDPs of its two legs.
rtcp_enabled = true
transcoding_threads = 4
codecs = ["PCMU", "PCMA", "Opus"]
# (the address advertised in SDP is [network] public_ipv4 — [media] has no
# public_ip key of its own)

[media.webrtc]
enabled = true
stun_servers = ["stun:stun.l.google.com:19302"]
# TURN is intentionally external (coturn) — this key is reserved:
turn_enabled = false

[database]
# Embedded SQLite: source of truth for API-managed config. No external
# database is required to run the SBC. A store that cannot be opened or
# read at boot is fatal (the SBC would run with no users, trunks or DIDs);
# allow_missing_store = true restores the old warn-and-run-from-TOML
# behaviour (/ready then stays 503).
sqlite_path = "/var/lib/sbc/sbc.db"
allow_missing_store = false
# Backups: POST /api/v1/backup and a timer write sbc-<timestamp>.db copies
# (VACUUM INTO, dir 0700, files 0600 — they hold trunk passwords and user
# HA1s) and keep the backup_keep newest. backup_interval_hours = 0 disables
# the timer; default backup_dir is <dir of sqlite_path>/backups.
backup_dir = "/var/lib/sbc/backups"
backup_interval_hours = 24
backup_keep = 7

# Key classes (docs/API.md "Reload vs restart"): most [security] values
# apply on SIGHUP / POST /api/v1/reload; listeners, ports, database,
# realm, [management], [trunk_health] and [logging] need a restart;
# users/trunks/dids/rules are first-boot seeds. GET /api/v1/config shows
# what the file on disk would change.
[security]
rate_limit_global = 1000
rate_limit_per_ip = 50
auth_challenge_timeout = 30
sip_realm = "sip.example.com"
enable_digest_auth = true
# Identity rules. A user authenticated by Digest may only REGISTER its own
# AOR on a served domain ("enforce" = 403, "log" = report only); an INVITE
# from a registered phone must carry that phone's identity; an unregistered
# source claiming a local user is challenged (407). A trunk that presents a
# local user as From is flagged and relayed unattributed ("allow") or
# refused ("reject").
register_aor_check = "enforce"
served_domains = []            # when set, AOR hosts are restricted to these (+ realm/public IP); empty = foreign hosts only reported
# Registrar (RFC 3261 §10.3): a REGISTER asking less than register_min_expires
# is answered 423 Interval Too Brief + Min-Expires (1 disables the check:
# short intervals are then granted as asked); more than register_max_expires
# is granted register_max_expires (phones read it back in the 200's Contact
# and re-register accordingly); no interval at all gets register_default_expires.
register_min_expires = 60
register_max_expires = 3600
register_default_expires = 3600
trunk_local_from = "allow"

# Call guards
max_call_duration = 14400      # answered call hard cap → BYE both legs (CDR "timeout"); 0 = unlimited, any other value is floored at 60 s
call_setup_timeout = 60        # unanswered INVITE → CANCEL + 408 to the caller (CDR "setup-timeout")
rtp_timeout = 90               # no RTP *delivered* for this long → BYE both legs (CDR
                               # "rtp-timeout"), including a call whose media never flowed.
                               # Checked on a 30 s sweep, so the teardown lands 90-120 s in.
                               # One direction silent while the other talks is reported, not
                               # torn down (sbc_media_one_way_calls_total, a hold looks the same).
invite_timeout = 5             # no >=180 within 5s → trunk failover (raise above the carrier's post-dial delay when a backup trunk exists; a trunk that answered nothing at all also takes a strike)

# RFC 4028 session timers (refresh re-INVITEs on the trunk leg so >4h
# calls survive). Off by default; enable after validating with your trunk.
# The SBC owns the offer on the trunk leg (the caller's Session-Expires /
# Min-SE are replaced) and answers a "422 Session Interval Too Small" by
# re-sending the INVITE once with the trunk's Min-SE (RFC 4028 §7.4).
# Trunks with a high floor (Genesys: 14400) accept the first INVITE when
# session_expires is raised to it; keep min_se low — a UAS may lower
# Session-Expires in its 2xx. Changes are applied on SIGHUP / POST reload.
session_timer_enabled = false
session_expires = 1800
min_se = 90

# First-boot seeds — manage users via POST /api/v1/users afterwards
[security.sip_users]
#alice = "change-me"

# ── Anti-fraud ───────────────────────────────────────────────────────────
[security.ban]                  # fail2ban-style SIP banning
enabled = true
max_failures = 5                # strikes within window_secs → ban
window_secs = 60
ban_duration_secs = 3600
repeat_offender_multiplier = 4  # 2nd ban 4h, 3rd 16h… capped below
max_ban_secs = 86400
silent_drop = true              # drop packets (false = answer 403)
whitelist = ["127.0.0.1"]

[security.destinations]        # anti-IRSF destination blocking
enabled = true
default_action = "allow"        # "deny" = allowlist mode
default_country_code = "33"
seed_irsf_rules = true          # auto-deny +881/+882/+883/+979
# [[security.destinations.rules]]
# prefix = "+889"
# action = "deny"
# description = "premium range"
# user = "alice"               # omit for a global rule

[security.user_limits]
enabled = true
default_max_concurrent_calls = 4   # 0 = unlimited
default_max_calls_per_minute = 10
# [[security.user_limits.overrides]]
# user = "pbx-gateway"
# max_concurrent_calls = 30
# max_calls_per_minute = 120

[management]
api_enabled = true
api_bind_address = "127.0.0.1"  # bind publicly only behind TLS + firewall
api_port = 8080
# PREFER supplying the token via the SBC_API_TOKEN environment variable
# (systemd EnvironmentFile, 600 root:root) instead of writing it here in
# clear text. The env var overrides this key. Generate with:
#   openssl rand -hex 32
# If a token IS written below, this file MUST be chmod 600. The API refuses
# to start when enabled without a token (fail-closed).
api_auth_token = "GENERATE-A-LONG-RANDOM-TOKEN"
# cors_allowed_origins = ["https://admin.example.com"]
# Peers whose X-Real-IP / X-Forwarded-For are believed for rate limiting,
# audit and bans (the nginx of INSTALL.md); from any other peer the TCP
# address is the client. Failed token checks strike the client's IP in
# fail2ban like a SIP password guess; a banned IP gets 403 without a valid
# token, a valid token is always served (the API is what lifts bans).
trusted_proxies = ["127.0.0.1", "::1"]
ban_on_auth_failure = true

[trunk_health]
# OPTIONS probe per enabled trunk (sbc_trunk_up{trunk}, SSE trunk_health);
# a trunk that stops answering rests through the router's cooldown. The
# probes and outbound REGISTER loops follow the trunk table live (API,
# reload) — these timings are read at boot only.
# Both are sent over the SIP UDP socket: a trunk whose transport is TCP,
# TLS, WS or WSS gets no probe and no outbound REGISTER (its health then
# comes from real calls only).
options_interval = 30
options_timeout = 5
# A *refused* outbound REGISTER (4xx/5xx, and a 423 whose Min-Expires does
# not help) backs off exponentially from 30 s up to this cap, reset on
# success. A timeout or a send failure keeps a fixed 60 s retry instead, so
# one lost datagram does not stretch into a long outage. A 423 Interval Too
# Brief is retried once with the trunk's Min-Expires, which is remembered.
register_backoff_max = 900

[metrics]
# Parsed for compatibility, not used: metrics are served by the management
# API at GET /metrics (bearer token), see monitoring/README.md.
prometheus_enabled = true
prometheus_bind_address = "127.0.0.1"
prometheus_port = 9090

[cdr]
# CDRs are rows of the SQLite store (GET /api/v1/cdrs filters, cursor, CSV).
# jsonl_path mirrors every committed record as JSON lines (falls back to the
# legacy [general] cdr_file); the history in that file and its rotated .N
# siblings is imported once at first boot (import_jsonl; .gz files are
# skipped — zcat them into import_path first if you need them). Rows older
# than retention_days are purged daily (0 keeps everything). Boot-only.
jsonl_path = "/var/log/sbc/cdr.jsonl"
retention_days = 400
import_jsonl = true

[logging]
# A level or tracing EnvFilter directives: "info", "debug",
# "sbc_core::media=debug,info". Precedence: `sbc --verbose` (debug) >
# RUST_LOG in the environment (/etc/sbc/sbc.env) > this key. Run at info:
# the per-call span (uuid, call_id, trunk, direction) is an info-level
# span, so at warn/error the lines lose their call context.
level = "info"
# "text" for a terminal / journald (`call{uuid=… call_id=… trunk=…}: msg`),
# "json" for log shipping: one object per line with timestamp, level,
# target, message and `span` = {name: "call", uuid, call_id, trunk,
# direction} on every line of a call (trunk/direction absent, not empty,
# until known — local calls have no trunk). Per-message and per-packet
# diagnostics are at debug; the writer is non-blocking and lossy
# (sbc_log_dropped_lines_total counts what journald did not take).
format = "json"

# ── First-boot trunk seed (then use POST /api/v1/trunks) ────────────────
#[[trunks]]
#name = "pstn-1"
#host = "sip.provider.example"
#port = 5060
#transport = "UDP"              # UDP | TCP | TLS | WS | WSS
#auth_required = true
#username = "account"
#password = "secret"
#prefix_patterns = ["+33", "0"]
#priority = 10
#number_format = "national"
#country_code = "33"
#national_prefix = "0"
# TLS trunks (transport = "TLS") verify the server cert against the system
# roots; override with tls_ca_cert / tls_sni, or add tls_client_cert +
# tls_client_key for mutual TLS.

# ── First-boot DID seed (then use POST /api/v1/dids) ────────────────────
#[[dids]]
#number = "0123456789"
#user = "alice"
